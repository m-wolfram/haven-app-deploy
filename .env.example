# Local mode by default. See README for the nginx and TURN overlays.
COMPOSE_FILE=docker-compose.yml
HAVEN_PORT=3000

# Required with either nginx overlay. Example: chat.example.com (without https://).
HAVEN_DOMAIN=
# Required only with an external nginx. Use its existing Docker network.
PROXY_NETWORK=
# Optional with the bundled nginx and Let's Encrypt.
LETSENCRYPT_EMAIL=

# Required only with TURN. Use your server's public IP and a random secret.
TURN_IP=
TURN_SECRET=
TURN_MIN_PORT=49160
TURN_MAX_PORT=49200
